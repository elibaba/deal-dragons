# Copy to .env (git-ignored). No secret VALUES belong here - only identifiers.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_REGION=us-central1
# Set after `terraform apply` to use Agent Engine Sessions + Memory Bank (else local SQLite).
AGENT_ENGINE_ID=
FAST_MODEL=gemini-3.5-flash
PRO_MODEL=gemini-3.1-pro-preview
ENABLE_CLOUD_TRACE=false
ENABLE_CLOUD_DLP=false
MODEL_ARMOR_TEMPLATE=
# Secret Manager secret ids (values are fetched at runtime, never stored in files)
CRM_TOKEN_SECRET_ID=deal-dragons-crm-token
GEMINI_API_KEY_SECRET_ID=deal-dragons-gemini-api-key
